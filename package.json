{
  "name": "fantasy-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx --env-file-if-exists=.env watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "test": "tsx --test src/kernel/*.test.ts src/server/*.test.ts src/nba/*.test.ts",
    "data:players": "tsx scripts/fetch-players.ts",
    "data:rankings": "tsx scripts/data-rankings.ts",
    "data:idp": "tsx scripts/fetch-idp.ts",
    "data:nba": "tsx scripts/nba-data.ts",
    "values:nba": "tsx scripts/nba-values.ts",
    "draft:nba": "tsx scripts/nba-draft.ts",
    "check:lists": "tsx scripts/check-lists.ts",
    "test:e2e": "tsx --test test/e2e.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "replay": "sh scripts/replay-local.sh"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
