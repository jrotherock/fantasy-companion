node_modules/
.DS_Store
*.log

# Working files, not part of the project
scratch/

# Personal draft board: like / do-not-draft lists. Kept out of a public repo so
# leaguemates cannot read your targets. The strategy rules stay in.
data/preferences/*.json
!data/preferences/*.rules.json

# Live draft state — regenerated at the table, changes every pick
fixtures/log-*.jsonl

# Draft archive: manifests and frozen boards are local history, not source
fixtures/drafts/

# Leagues discovered from an open draft room are built at runtime
data/rankings-yahoo-live-*.json
# A league found through the API borrows a board the same way.
data/rankings-yahoo-[0-9]*.json
data/leagues/yahoo-live-*.json

# Recorded raw adapter payloads can get large; keep the curated ones only
fixtures/raw-*.json

# Secrets and credentials. push.json holds the VAPID private key, which is the
# authority to send notifications to every subscribed device; passkeys.json
# holds credential records and live session tokens. Neither belongs in a repo,
# least of all a public one.
fixtures/push.json
fixtures/passkeys.json

# Alert history: what was sent and when. Local state, not source.
fixtures/alerts.json

# Poller state: rewritten every ten minutes, so it churns the history for
# nothing. The snapshots are a cache of Sleeper, rebuildable on the next run.
fixtures/news-log.jsonl
fixtures/player-snapshot.json
fixtures/trending-snapshot.json
fixtures/notifications.json
fixtures/yahoo-rosters.json
fixtures/board-snapshot.json
# Every nflverse table is a cache of a public file, rebuilt on demand.
fixtures/nflverse-*.json

# League configs are committed. Keeping them out meant carrying four kilobytes
# of JSON in an environment variable and keeping it in sync by hand all season
# — a real operational cost against a theoretical tidiness. They hold no
# secrets: league keys, slot shapes, a draft time. LEAGUES_JSON still overrides
# them, so a fork can supply its own without touching these.

# Boards. Called cache once and ignored, which was wrong: the server skips any
# league whose rankings are missing, so a deploy without them came up with no
# leagues at all. They are public projections, a few hundred kilobytes, and
# required input. Mock-draft boards stay out — those really are throwaway.

# Build output. Railway builds it; committing it just churns the history.
dist/

# Local environment: Sleeper id, contact address, token.
.env

# Runtime caches. These live in STATE_DIR, which is `fixtures` locally and a
# volume in production — they are state, not source, and committing them means
# every poll shows up as a diff.
fixtures/availability.json
fixtures/weather.json
fixtures/weekly-ranks.json
# RotoBaller's WR/CB verdicts and the chart read off their screenshots. The
# chart is sold as a premium tool, so it stays in state and out of a repository
# other people can read.
fixtures/wrcb-*.json
# Injury analysts' takes, read by hand, and the season's ledger of them.
fixtures/expert-takes-*.json
fixtures/projections.json
fixtures/board-snapshot.json
# Yahoo API state. The recording is every league's rosters and standings with
# leaguemates' team names in it, taken through the deployed server so a local
# run can replay Yahoo without holding its token; the rest is the adapter's
# store and its backoff state. None of it is source, and the recording is other
# people's data besides.
fixtures/yahoo-recording-*.json
fixtures/yahoo-leagues.json
fixtures/yahoo-sync.json
fixtures/yahoo-oauth.json
fixtures/yahoo-limits.json

# Basketball source downloads (Sleeper, FantasyPros, ESPN schedule, Basketball-
# Reference). A cache of public pages, rebuilt by `npm run data:nba`; the joined
# tables beside them are what the app reads.
data/nba/raw/
